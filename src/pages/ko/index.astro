---
import BaseLayout from '../../layouts/BaseLayout.astro';
import metrics from '../../data/metrics.json';
import works from '../../data/works.json';

const {
  published_works_count,
  cumulative_revenue,
  cumulative_costs,
  discarded_experiments_count,
  last_updated
} = metrics;

const layers = [
  {
    step: "1. 이해",
    path: "/ko/learn/",
    title: "무엇을 어떻게 하는가",
    desc: "AI 도구 활용, 에이전트, 비전공자 만들기부터 자동화까지 단계별 강의."
  },
  {
    step: "2. 결과물",
    path: "/ko/works/",
    title: "실제로 만들어진 것",
    desc: "매일 생성되는 주식 인사이트, 웹 도구, 어플리케이션, 게임 목록."
  },
  {
    step: "3. 과정",
    path: "/ko/how/",
    title: "제작 과정 · 비용 · 시간",
    desc: "결과물마다 사용한 프롬프트 원문, 모델, 제작 시간, 막힌 지점과 해결 기록."
  },
  {
    step: "4. 검증",
    path: "/ko/results/",
    title: "수익 · 실패 · 적중률",
    desc: "월별 결산표, 30일/90일 인사이트 채점 결과, 폐기된 실험의 솔직한 내역."
  }
];

// Latest 3 items across layers (Section 4.1 #4)
const latestItems = [
  {
    layer: "결과물",
    title: "Dividend Snowball Calculator",
    desc: "복리 재투자 배당금과 장기 자산 성장 시뮬레이터",
    link: "/ko/works/"
  },
  {
    layer: "과정",
    title: "배당 눈덩이 계산기: 복리 재투자 시뮬레이터 제작기",
    desc: "Gemini와 Claude로 1시간 만에 구현한 프롬프트와 세금 오차 해결 기록",
    link: "/ko/how/dividend-calculator/"
  },
  {
    layer: "이해",
    title: "미국 배당주 실전 입문 10강 (자산 이관 완료)",
    desc: "배당 기본 원리부터 복리 재투자, 캘린더 설계, 세금까지 실전 가이드",
    link: "/ko/learn/track-5-dividend/01-what-is-dividend/"
  }
];
---

<BaseLayout 
  title="공개 운영 실험실 기록"
  description="AI로 직접 도구를 만들어서, 그 도구로 검증한 결과와 숫자를 전부 공개합니다."
>
  <div class="site-shell">
    <!-- 1. Hero: Measured Numbers (Section 4.1) -->
    <section class="hero-metrics" aria-label="실측 숫자 현황">
      <div class="metrics-grid tabular-nums">
        <div class="metric-cell">
          <span class="metric-label">공개한 결과물</span>
          <span class="metric-value">{published_works_count}개</span>
        </div>
        <div class="metric-cell">
          <span class="metric-label">누적 수익</span>
          <span class="metric-value status-signal">${cumulative_revenue.toLocaleString()}</span>
        </div>
        <div class="metric-cell">
          <span class="metric-label">누적 비용</span>
          <span class="metric-value">${cumulative_costs.toLocaleString()}</span>
        </div>
        <div class="metric-cell">
          <span class="metric-label">폐기한 실험</span>
          <span class="metric-value status-alert">{discarded_experiments_count}건</span>
        </div>
      </div>
      <p class="metrics-updated tabular-nums">기준일: {last_updated}</p>
    </section>

    <!-- 2. One-sentence summary (Within 2 lines) -->
    <section class="site-intro">
      <p class="lead-text">
        AI로 직접 도구를 만들어서, 그 도구로 검증한 결과와 숫자를 전부 공개합니다.<br />
        같은 대상에 대해 결과물 · 제작 과정 · 실측 숫자를 한자리에서 대조할 수 있습니다.
      </p>
    </section>

    <!-- 3. Four Journey Layers (Section 1.4 & 4.1) -->
    <section class="layers-section hairline-t">
      <h2 class="section-title">4단계 여정</h2>
      <div class="layers-list">
        {layers.map((layer) => (
          <div class="layer-row hairline-b">
            <div class="layer-meta">
              <span class="layer-step">{layer.step}</span>
              <a href={layer.path} class="layer-title">{layer.title}</a>
            </div>
            <p class="layer-desc">{layer.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Latest 3 Items across layers (Section 4.1) -->
    <section class="latest-section hairline-t">
      <h2 class="section-title">최신 기록 3선</h2>
      <div class="latest-list">
        {latestItems.map((item) => (
          <article class="latest-item hairline-b">
            <span class="latest-layer-badge">{item.layer}</span>
            <div class="latest-content">
              <h3 class="latest-title">
                <a href={item.link}>{item.title}</a>
              </h3>
              <p class="latest-desc">{item.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 5. Board / Request Action Link -->
    <section class="board-callout hairline-t">
      <p>
        만들어보고 싶은 도구나 개선 요청이 있으신가요? <a href="/ko/board/">요청 · 피드백 남기기</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  /* 1. Hero Metrics */
  .hero-metrics {
    padding: 2rem 0 3rem;
  }
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    padding: 2rem 0;
  }
  .metric-cell {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .metric-label {
    font-size: 0.85rem;
    color: var(--muted);
    letter-spacing: -0.01em;
  }
  .metric-value {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--ink);
  }
  .metrics-updated {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.75rem;
    margin-bottom: 0;
  }

  /* 2. Intro */
  .site-intro {
    padding: 1.5rem 0 3rem;
  }
  .lead-text {
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--ink);
    margin: 0;
  }

  /* 3. Four Layers */
  .layers-section, .latest-section {
    padding: 3rem 0;
  }
  .section-title {
    font-size: 1.25rem;
    margin-top: 0;
    margin-bottom: 2rem;
    color: var(--muted);
    font-weight: 600;
  }
  .layers-list {
    display: flex;
    flex-direction: column;
  }
  .layer-row {
    padding: 1.75rem 0;
  }
  .layer-meta {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .layer-step {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--muted);
    min-width: 70px;
  }
  .layer-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .layer-title:hover {
    color: var(--muted);
  }
  .layer-desc {
    font-size: 0.95rem;
    color: var(--muted);
    margin: 0;
    padding-left: 5.4rem;
    line-height: 1.6;
  }

  /* Latest Section */
  .latest-list {
    display: flex;
    flex-direction: column;
  }
  .latest-item {
    padding: 1.5rem 0;
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }
  .latest-layer-badge {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted);
    min-width: 60px;
  }
  .latest-content {
    flex: 1;
  }
  .latest-title {
    font-size: 1.15rem;
    margin: 0 0 0.35rem 0;
  }
  .latest-title a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .latest-title a:hover {
    color: var(--muted);
  }
  .latest-desc {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0;
  }

  /* 5. Board Callout */
  .board-callout {
    padding: 2.5rem 0 1rem;
    font-size: 0.95rem;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem 1rem;
    }
    .metric-value {
      font-size: 1.85rem;
    }
    .lead-text {
      font-size: 1.1rem;
    }
    .layer-desc {
      padding-left: 0;
      margin-top: 0.5rem;
    }
    .latest-item {
      flex-direction: column;
      gap: 0.35rem;
    }
  }

  @media (max-width: 480px) {
    .metrics-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .layer-meta {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>