---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import works from '../../../data/works.json';
---

<BaseLayout 
  title="2층: 결과물 (Works) - 제품 목록"
  description="AI로 직접 제작한 도구, 앱, 게임 및 데이터 파이프라인 목록"
>
  <div class="site-shell">
    <header class="works-hero hairline-b">
      <h1>2층: 결과물</h1>
      <p class="intro-lead">
        이곳에서는 실제로 만들어진 것들을 확인하고 직접 실행해볼 수 있습니다.<br />
        각 결과물은 3층의 제작 과정(/how) 및 4층의 실측 결산(/results)과 대조 가능하도록 연결되어 있습니다.
      </p>
    </header>

    <section class="works-list-section">
      <div class="works-list">
        {works.map((item) => {
          const isDiscarded = item.status === "폐기";
          return (
            <article class="work-item hairline-b">
              <div class="work-header">
                <div class="work-title-wrap">
                  <h2 class={isDiscarded ? "work-name discarded" : "work-name"}>
                    {item.name}
                  </h2>
                  <span class={
                    item.status === "공개" ? "status-tag status-signal" :
                    item.status === "폐기" ? "status-tag status-alert" :
                    "status-tag status-muted"
                  }>
                    {item.status}
                  </span>
                </div>
                <p class="work-desc">{item.desc}</p>
              </div>

              <div class="work-actions">
                {!isDiscarded && item.appPath && (
                  <a href={item.appPath} class="action-btn-exec">
                    실행하기
                  </a>
                )}
                {!isDiscarded && item.howPath && (
                  <a href={item.howPath} class="action-link">
                    제작 과정 (/how)
                  </a>
                )}
                {!isDiscarded && item.resultsPath && (
                  <a href={item.resultsPath} class="action-link">
                    실측 결과 (/results)
                  </a>
                )}
                {isDiscarded && item.failurePath && (
                  <a href={item.failurePath} class="action-link status-alert">
                    폐기 사유 보기 (/failures)
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .works-hero {
    padding-bottom: 2.5rem;
    margin-bottom: 3rem;
  }
  .intro-lead {
    font-size: 1.15rem;
    color: var(--muted);
    line-height: 1.7;
    margin-top: 1rem;
    margin-bottom: 0;
  }
  
  .works-list {
    display: flex;
    flex-direction: column;
  }
  .work-item {
    padding: 2.25rem 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
  }
  .work-header {
    flex: 1;
    max-width: 650px;
  }
  .work-title-wrap {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .work-name {
    font-size: 1.35rem;
    color: var(--ink);
    margin: 0;
    font-family: inherit;
  }
  .work-name.discarded {
    text-decoration: line-through;
    color: var(--muted);
  }
  .status-tag {
    font-size: 0.8rem;
    font-weight: 700;
  }
  .work-desc {
    font-size: 1rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.6;
  }

  .work-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }
  .action-btn-exec {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    border: 1px solid var(--ink);
  }
  .action-btn-exec:hover {
    background: var(--muted);
    border-color: var(--muted);
    color: var(--paper);
  }
  .action-link {
    font-size: 0.9rem;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .action-link:hover {
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .work-item {
      flex-direction: column;
      gap: 1.5rem;
    }
    .work-actions {
      flex-wrap: wrap;
      gap: 1rem;
    }
  }
</style>