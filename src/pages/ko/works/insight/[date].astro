---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allInsights = await getCollection('insight');
  
  // Section 6.3 Rule:
  // Exclude documents where generated_by == reviewed_by OR human_approved == false
  const validInsights = allInsights.filter((entry) => {
    if (entry.data.generated_by === entry.data.reviewed_by) return false;
    if (!entry.data.human_approved) return false;
    return true;
  });

  return validInsights.map((entry) => {
    const dateStr = entry.data.date.toISOString().slice(0, 10);
    return {
      params: { date: dateStr },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const dateStr = entry.data.date.toISOString().slice(0, 10);
---

<BaseLayout 
  title={`${dateStr} 주식 인사이트 (${entry.data.tickers.join(', ')})`}
  description={`${entry.data.tickers.join(', ')} 일일 정량 지표 분석 및 배당 체크리스트. AI 생성 및 교차 검증.`}
>
  <div class="container-reading">
    <header class="insight-post-header hairline-b">
      <div class="breadcrumb">
        <a href="/ko/works/insight/">← 주식 인사이트 목록</a>
        <span class="sep">/</span>
        <span class="date tabular-nums">{dateStr}</span>
      </div>

      <!-- AI Generation Notice (Section 4.3) -->
      <aside class="ai-notice-banner" aria-label="AI 생성 및 검증 안내">
        <div class="notice-top">
          <span class="notice-tag">AI 생성 고지</span>
          <span class="notice-text">이 분석은 AI가 생성하고 사람이 검토했습니다.</span>
          <a href="/ko/works/insight/how-it-works/" class="how-link">검증 원리 보기</a>
        </div>
        <div class="model-pipeline tabular-nums">
          <span>생성: <code>{entry.data.generated_by}</code></span>
          <span class="pipe-sep">→</span>
          <span>검증: <code>{entry.data.reviewed_by}</code></span>
          <span class="pipe-sep">→</span>
          <span class="approved-tag status-signal">사람 승인 완료</span>
        </div>
      </aside>

      <h1 class="post-title">{entry.data.tickers.join(' · ')} 일일 지표 분석</h1>

      <!-- Scoring Status Badge (Section 4.3 & 4.6) -->
      <div class="scoring-card tabular-nums">
        <span class="score-label">적중률 채점 상태:</span>
        <span class="score-pill">30일 ({entry.data.scoring.d30})</span>
        <span class="score-pill">90일 ({entry.data.scoring.d90})</span>
      </div>
    </header>

    <article class="insight-article-body tabular-nums">
      <Content />
    </article>

    <!-- Bottom Disclaimer (Section 4.3 & 7.3) -->
    <footer class="insight-post-footer hairline-t">
      <div class="disclaimer-callout">
        <h3 class="disc-title">⚠️ 투자 유의사항 및 법적 면책</h3>
        <p>
          본 분석은 인공지능 파이프라인의 데이터 정리 및 실험 기록이며, 자본시장법상 특정 금융투자상품의 매수·매도 추천이나 투자 조언이 아닙니다. 
          과거의 데이터와 채점 결과가 미래 수익을 보장하지 않습니다. 모든 투자 결정에 따른 책임은 투자자 본인에게 있습니다.
        </p>
        <p class="disc-link-p">
          <a href="/ko/legal/disclaimer/">면책조항 전문 보기</a>
        </p>
      </div>

      <div class="post-nav hairline-t">
        <a href="/ko/works/insight/">← 인사이트 목록으로</a>
        <a href="/ko/results/">적중률 검증표 확인 (/results)</a>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  .insight-post-header {
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
    display: flex;
    gap: 0.5rem;
  }
  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--ink);
  }
  .sep { color: var(--rule); }

  .ai-notice-banner {
    background: #FFFFFF;
    border: 1px solid var(--rule);
    border-left: 3px solid var(--ink);
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
  }
  .notice-top {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
  }
  .notice-tag {
    font-weight: 700;
    color: var(--ink);
  }
  .notice-text {
    color: var(--muted);
  }
  .how-link {
    color: var(--ink);
    text-decoration: underline;
  }
  .model-pipeline {
    font-size: 0.8rem;
    color: var(--muted);
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .model-pipeline code {
    background: var(--paper);
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--rule);
    color: var(--ink);
  }
  .pipe-sep { color: var(--rule); }
  .approved-tag { font-weight: 600; }

  .post-title {
    font-size: 1.85rem;
    line-height: 1.35;
    margin-bottom: 1.25rem;
  }

  .scoring-card {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .score-label { font-weight: 600; }
  .score-pill {
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 0.15rem 0.5rem;
  }

  .insight-article-body {
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--ink);
    margin-bottom: 3.5rem;
  }
  .insight-article-body :global(h2) {
    font-size: 1.35rem;
    margin-top: 3rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.4rem;
  }
  .insight-article-body :global(h3) {
    font-size: 1.15rem;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }
  .insight-article-body :global(p) { margin-bottom: 1.5em; }
  .insight-article-body :global(ul), .insight-article-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .insight-article-body :global(li) { margin-bottom: 0.4rem; }
  .insight-article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.95rem;
  }
  .insight-article-body :global(th), .insight-article-body :global(td) {
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .insight-article-body :global(th) {
    color: var(--muted);
    border-bottom: 2px solid var(--rule);
  }

  .insight-post-footer {
    padding-top: 2rem;
  }
  .disclaimer-callout {
    background: #FFFFFF;
    border: 1px solid var(--rule);
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  .disc-title {
    font-size: 1rem;
    color: var(--ink);
    margin-top: 0;
    margin-bottom: 0.75rem;
  }
  .disclaimer-callout p {
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .disc-link-p { margin-bottom: 0 !important; }
  .disc-link-p a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    padding-top: 1.5rem;
    font-size: 0.95rem;
  }
  .post-nav a {
    color: var(--ink);
    text-decoration: underline;
  }
</style>